    "steps": [
      "keep Electricity Maps zones 'US-*' whose last key part is an EIA-930 BA code (drops US-AK, US-AK-SEAPA, US-HI)",
      "clip each zone to Natural Earth 1:10m admin-0 USA (large lakes cut out), window [-126.0, 24.0, -66.0, 50.0]",
      "give every uncovered land sliver to the nearest zone (ordered Voronoi of zone boundaries densified to 0.02 deg), then shapely.coverage_clean",
      "shapely.coverage_simplify tolerance 0.005 deg; round to 4 decimals",
      "SWPW (SPP West, active 2026-04-01) = coverage union of WACM + WAUW (approximate)"
    ],
